#!/usr/bin/env bash
# Commit the task folders of one project in mypi home on main and push.
#   mp-home-commit <KEY|CODE> "<message>"
# Stages only <project home>/requests|tasks|batches; everything else is reported, not staged.
set -euo pipefail
ENGINE=${MYPI_ENGINE_ROOT:-$PWD}
# The installation root: the engine checkout with home/ and projects/ beside it.
[[ -f "$ENGINE/package.json" && -d "$ENGINE/home" && -d "$ENGINE/projects" ]] \
  || { echo "{\"error\":\"run from the installation root (engine checkout with home/ and projects/), got $ENGINE\"}" >&2; exit 2; }
HOME_DIR=$ENGINE/home
BIN=$(cd "$(dirname "$0")" && pwd)
target=${1:-}; msg=${2:-}
[[ -n "$target" && -n "$msg" ]] || { echo "usage: mp-home-commit <KEY|CODE> \"<message>\"" >&2; exit 2; }
proj=$("$BIN/mp-task" project "$target")
home=$(python3 -c 'import sys,json;print(json.load(sys.stdin)["home"])' <<<"$proj")
rel=${home#"$HOME_DIR"/}
cd "$HOME_DIR"
[[ "$(git branch --show-current)" == main ]] || { echo '{"error":"home is not on main"}'; exit 1; }
paths=()
for p in "$rel/requests" "$rel/tasks" "$rel/batches"; do [[ -d "$p" ]] && paths+=("$p"); done
[[ ${#paths[@]} -gt 0 ]] || { echo '{"committed":false,"reason":"no task folders"}'; exit 0; }
git add -A -- "${paths[@]}"
if git diff --cached --quiet; then
  echo "{\"committed\":false,\"reason\":\"nothing staged\",\"other_changes\":$(git status --porcelain | wc -l)}"; exit 0
fi
git commit -q -m "$msg"
git push -q origin main
sha=$(git rev-parse --short HEAD)
other=$(git status --porcelain | wc -l)
echo "{\"committed\":true,\"sha\":\"$sha\",\"other_changes\":$other}"

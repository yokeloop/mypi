{
  "mcpServers": {
    "mypi": {
      "command": "/absolute/path/to/node24",
      "args": [
        "/absolute/path/to/mypi/dist/src/mcp/main.js"
      ],
      "description": "Local mypi tools for memory, projects, requests and history.",
      "exposure": "codemode",
      "toolExposure": {
        "project_resolve": "direct",
        "warmup": "direct"
      }
    }
  }
}

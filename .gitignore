# home/ — nested git repo or local link to personal data, never commit into mypi git
/home

# .pi/ — local user-layer link/configuration; never claim these paths upstream
/.pi

# projects/ — working clones
/projects/

# local junk
.DS_Store

# Node build/dependencies
node_modules/
dist/

# Never store runtime databases or snapshots in the engine repository
*.sqlite3
*.sqlite3-*
*.db
*.db-*